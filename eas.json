{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://orion-pos-api.ayushpalworkplace2006.workers.dev"
      }
    },
    "diagnostic-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://orion-pos-api.ayushpalworkplace2006.workers.dev",
        "EXPO_PUBLIC_STARTUP_DIAGNOSTICS": "true"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://orion-pos-api.ayushpalworkplace2006.workers.dev"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://orion-pos-api.ayushpalworkplace2006.workers.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
